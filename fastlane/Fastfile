default_platform(:mac)

def project_path
  File.expand_path("../NextUp.xcodeproj", __dir__)
end

def build_dir
  File.expand_path("../build", __dir__)
end

# CI passes APPLE_TEAM_ID. Locally there's no need: the team isn't secret
# and the project already signs with it, so read it from there.
def nextup_team_id
  from_env = ENV["APPLE_TEAM_ID"].to_s
  return from_env unless from_env.empty?

  require "xcodeproj"
  target = Xcodeproj::Project.open(project_path).targets.find { |t| t.name == "NextUp" }
  team = target&.build_configurations&.first&.build_settings&.fetch("DEVELOPMENT_TEAM", nil)
  UI.user_error!("No DEVELOPMENT_TEAM on the NextUp target and APPLE_TEAM_ID unset") if team.to_s.empty?
  team
end

# The App Store Connect API key, shared by every lane that talks to Apple.
# Key auth needs no 2FA and doesn't get throttled the way repeated Apple ID
# logins do. GitHub holds the .p8 base64-encoded (a secret can't carry
# newlines); a raw PEM works too, so the encoding is sniffed.
def asc_api_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s
  issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"].to_s
  key_content = ENV["APP_STORE_CONNECT_API_KEY"].to_s

  if [key_id, issuer_id, key_content].any?(&:empty?)
    UI.user_error!(
      "No App Store Connect API key. Set APP_STORE_CONNECT_API_KEY_ID, " \
      "APP_STORE_CONNECT_API_ISSUER_ID and APP_STORE_CONNECT_API_KEY."
    )
  end

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_content: key_content,
    is_key_content_base64: !key_content.start_with?("-----BEGIN"),
    in_house: false
  )
end

# "v1.2.0" or "1.2.0" → "1.2.0".
def release_version
  version = ENV.fetch("VERSION", "").delete_prefix("v")
  UI.user_error!("Set VERSION to the release version, e.g. VERSION=1.2.0") unless version.match?(/\A\d+(\.\d+){1,2}\z/)
  version
end

# The Xcode project is generated, so every lane starts from a fresh one.
before_all do
  sh(File.expand_path("../Scripts/generate.sh", __dir__))
end

platform :mac do
  desc "One-time, run locally: create the Developer ID Application certificate"
  desc "in the match repo. Apple only lets the Account Holder create Developer ID"
  desc "certificates; if the API refuses, create it in Xcode and import it with"
  desc "`bundle exec fastlane match import` (see README)."
  lane :certificates do
    match(api_key: asc_api_key, readonly: false)
  end

  desc "Install the Developer ID certificate on this Mac. Read-only."
  lane :setup do
    match(readonly: true)
  end

  desc "Run the unit tests."
  lane :test do
    run_tests(
      project: project_path,
      scheme: "NextUp",
      destination: "platform=macOS",
      output_directory: "#{build_dir}/test_output",
      # Tests don't need a real identity; sign ad-hoc so CI needs no secrets.
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM="
    )
  end

  desc "Build, sign with Developer ID, notarize and zip the app for a release."
  desc "Needs VERSION (e.g. 1.2.0). Writes build/NextUp-<version>.zip. Used by CI."
  lane :release do
    setup_ci if ENV["CI"]

    api_key = asc_api_key
    team = nextup_team_id
    version = release_version
    build_number = ENV.fetch("GITHUB_RUN_NUMBER", "1")

    match(readonly: true, api_key: api_key, team_id: team)

    # The project signs automatically with an Apple Development certificate
    # for local runs. A release signs manually with Developer ID instead.
    build_app(
      project: project_path,
      scheme: "NextUp",
      configuration: "Release",
      export_method: "developer-id",
      output_directory: build_dir,
      output_name: "NextUp",
      clean: true,
      skip_package_pkg: true,
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{team}",
        "CODE_SIGN_IDENTITY='Developer ID Application'",
        "MARKETING_VERSION=#{version}",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" "),
      export_options: {
        method: "developer-id",
        signingStyle: "manual",
        teamID: team,
        signingCertificate: "Developer ID Application"
      }
    )

    app = File.join(build_dir, "NextUp.app")
    UI.user_error!("Expected #{app} after export") unless File.directory?(app)

    # Notarizes and staples the ticket, so Gatekeeper accepts the app offline.
    notarize(package: app, api_key: api_key)
    sh("spctl", "--assess", "--verbose=2", "--type", "execute", app)

    zip = File.join(build_dir, "NextUp-#{version}.zip")
    # ditto, not zip: it keeps the extended attributes the signature needs.
    sh("ditto", "-c", "-k", "--keepParent", app, zip)
    UI.success("Notarized release: #{zip}")
  end
end

platform :ios do
  # Values live in the xcconfigs so the project and the lanes can't disagree.
  def xcconfig_value(env, key)
    path = File.expand_path("../Config/#{env == 'prod' ? 'Prod' : 'Dev'}.xcconfig", __dir__)
    line = File.readlines(path).find { |l| l.match?(/\A#{Regexp.escape(key)}\s*=/) }
    UI.user_error!("#{key} missing from #{path}") unless line
    line.split("=", 2).last.strip
  end

  def ios_ids(env)
    app = xcconfig_value(env, "NEXTUP_IOS_BUNDLE_ID")
    [app, "#{app}.Widget", "#{app}.watchkitapp", "#{app}.watchkitapp.Widget"]
  end

  # Longest suffix first: the watch widget's ID also ends in ".Widget".
  def ios_app_name(bundle_id, name)
    suffix = { ".watchkitapp.Widget" => " Watch Widget", ".watchkitapp" => " Watch", ".Widget" => " Widget" }
             .find { |s, _| bundle_id.end_with?(s) }&.last
    "#{name}#{suffix}"
  end

  def ios_apple_id
    ENV["FASTLANE_USER"].to_s.empty? ? UI.user_error!("Set FASTLANE_USER to your Apple ID") : ENV["FASTLANE_USER"]
  end

  desc "One-time, run locally: register the iOS App IDs and App Groups for prod and dev."
  lane :bootstrap do
    team = nextup_team_id
    creds = "-u #{ios_apple_id} -b #{team}"
    %w[prod dev].each do |env|
      group = xcconfig_value(env, "NEXTUP_APP_GROUP")
      name = xcconfig_value(env, "NEXTUP_DISPLAY_NAME")
      UI.header("#{env}: #{ios_ids(env).join(', ')}")
      # The in-process produce calls go first: they are the only ones that can prompt for the Apple ID
      # password and 2FA code. The `sh` subprocesses below get no terminal and reuse the cached login.
      ios_ids(env).each do |bundle_id|
        produce(app_identifier: bundle_id, app_name: ios_app_name(bundle_id, name),
                username: ios_apple_id, team_id: team, skip_itc: true, sku: bundle_id, language: "en-US", platform: "ios")
      end
      sh("fastlane produce group #{creds} -g #{group} -n \"#{name} group\"")
      ios_ids(env).each do |bundle_id|
        # Enable before associating: enabling App Groups clears the groups already selected on the App ID,
        # which yields a profile with an empty application-groups entitlement. Learned the hard way in Earful.
        sh("fastlane produce enable_services #{creds} -a #{bundle_id} --app-group")
        sh("fastlane produce associate_group #{creds} -a #{bundle_id} #{group}")
      end
    end
    UI.success("App IDs and groups ready. Next: bundle exec fastlane ios appstore_record, then ios certificates")
  end

  desc "Create the App Store Connect record TestFlight needs. Names are unique across the App Store;"
  desc "set NEXTUP_ASC_NAME if 'Next Up' is taken. The home screen name comes from the xcconfig."
  lane :appstore_record do
    bundle_id = ios_ids("prod").first
    produce(app_identifier: bundle_id, app_name: ENV.fetch("NEXTUP_ASC_NAME", "Next Up"),
            username: ios_apple_id, team_id: nextup_team_id, skip_devcenter: true,
            sku: bundle_id, language: "en-US", platform: "ios")
  end

  desc "Create or renew iOS development and App Store profiles in the match repo."
  lane :certificates do
    ids = ios_ids("prod") + ios_ids("dev")
    %w[development appstore].each do |type|
      match(type: type, platform: "ios", app_identifier: ids, readonly: false,
            skip_provisioning_profiles: false, api_key: asc_api_key)
    end
  end

  desc "Install iOS certificates and profiles on this Mac. Read-only."
  lane :setup do
    ids = ios_ids("prod") + ios_ids("dev")
    %w[development appstore].each do |type|
      match(type: type, platform: "ios", app_identifier: ids, readonly: true, skip_provisioning_profiles: false)
    end
  end

  desc "Build the prod app and upload it to TestFlight. Used by the TestFlight workflow."
  lane :beta do
    setup_ci if ENV["CI"]
    api_key = asc_api_key
    team = nextup_team_id
    ids = ios_ids("prod")
    app_id = ids.first

    match(type: "appstore", platform: "ios", app_identifier: ids, readonly: true,
          skip_provisioning_profiles: false, api_key: api_key, team_id: team)

    build_number = latest_testflight_build_number(api_key: api_key, app_identifier: app_id,
                                                  platform: "ios", initial_build_number: 0) + 1

    build_app(
      project: project_path,
      scheme: "NextUpiOS",
      configuration: "Release",
      export_method: "app-store",
      output_directory: build_dir,
      output_name: "NextUp",
      clean: true,
      xcargs: "DEVELOPMENT_TEAM=#{team} CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team,
        provisioningProfiles: ids.to_h { |id| [id, "match AppStore #{id}"] }
      }
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true, distribute_external: false)
  end

  desc "Create an internal TestFlight group that gets every build and add TESTER_EMAIL (an App Store Connect user)."
  lane :internal_testers do
    asc_api_key
    email = ENV["TESTER_EMAIL"].to_s
    UI.user_error!("Set TESTER_EMAIL to an App Store Connect user's email") if email.empty?
    app = Spaceship::ConnectAPI::App.find(ios_ids("prod").first) || UI.user_error!("No App Store Connect app yet; run ios appstore_record")
    group = app.get_beta_groups.find(&:is_internal_group)
    unless group
      # spaceship's create_beta_group always sends public-link fields, which Apple rejects for internal groups.
      Spaceship::ConnectAPI.test_flight_request_client.post("v1/betaGroups", {
        data: {
          type: "betaGroups",
          attributes: { name: "Internal", isInternalGroup: true, hasAccessToAllBuilds: true },
          relationships: { app: { data: { type: "apps", id: app.id } } }
        }
      })
      group = app.get_beta_groups.find(&:is_internal_group) || UI.user_error!("Internal group missing after create")
    end
    user = Spaceship::ConnectAPI::User.all.find { |u| u.username.to_s.casecmp?(email) || u.email.to_s.casecmp?(email) }
    UI.user_error!("#{email} is not an App Store Connect user on this team") unless user
    Spaceship::ConnectAPI.post_beta_tester_assignment(
      beta_group_ids: [group.id],
      attributes: { email: user.email || user.username, firstName: user.first_name, lastName: user.last_name }
    )
    UI.success("#{email} is in the #{group.name} TestFlight group")
  end
end
