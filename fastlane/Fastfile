default_platform(:mac)

platform :mac do
  def project_path
    File.expand_path("../NextUp.xcodeproj", __dir__)
  end

  def build_dir
    File.expand_path("../build", __dir__)
  end

  # CI passes APPLE_TEAM_ID. Locally there's no need: the team isn't secret
  # and the project already signs with it, so read it from there.
  def nextup_team_id
    from_env = ENV["APPLE_TEAM_ID"].to_s
    return from_env unless from_env.empty?

    require "xcodeproj"
    target = Xcodeproj::Project.open(project_path).targets.find { |t| t.name == "NextUp" }
    team = target&.build_configurations&.first&.build_settings&.fetch("DEVELOPMENT_TEAM", nil)
    UI.user_error!("No DEVELOPMENT_TEAM on the NextUp target and APPLE_TEAM_ID unset") if team.to_s.empty?
    team
  end

  # The App Store Connect API key, shared by every lane that talks to Apple.
  # Key auth needs no 2FA and doesn't get throttled the way repeated Apple ID
  # logins do. GitHub holds the .p8 base64-encoded (a secret can't carry
  # newlines); a raw PEM works too, so the encoding is sniffed.
  def asc_api_key
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s
    issuer_id = ENV["APP_STORE_CONNECT_API_ISSUER_ID"].to_s
    key_content = ENV["APP_STORE_CONNECT_API_KEY"].to_s

    if [key_id, issuer_id, key_content].any?(&:empty?)
      UI.user_error!(
        "No App Store Connect API key. Set APP_STORE_CONNECT_API_KEY_ID, " \
        "APP_STORE_CONNECT_API_ISSUER_ID and APP_STORE_CONNECT_API_KEY."
      )
    end

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: !key_content.start_with?("-----BEGIN"),
      in_house: false
    )
  end

  # "v1.2.0" or "1.2.0" → "1.2.0".
  def release_version
    version = ENV.fetch("VERSION", "").delete_prefix("v")
    UI.user_error!("Set VERSION to the release version, e.g. VERSION=1.2.0") unless version.match?(/\A\d+(\.\d+){1,2}\z/)
    version
  end

  desc "One-time, run locally: create the Developer ID Application certificate"
  desc "in the match repo. Apple only lets the Account Holder create Developer ID"
  desc "certificates; if the API refuses, create it in Xcode and import it with"
  desc "`bundle exec fastlane match import` (see README)."
  lane :certificates do
    match(api_key: asc_api_key, readonly: false)
  end

  desc "Install the Developer ID certificate on this Mac. Read-only."
  lane :setup do
    match(readonly: true)
  end

  desc "Run the unit tests."
  lane :test do
    run_tests(
      project: project_path,
      scheme: "NextUp",
      destination: "platform=macOS",
      output_directory: "#{build_dir}/test_output",
      # Tests don't need a real identity; sign ad-hoc so CI needs no secrets.
      xcargs: "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM="
    )
  end

  desc "Build, sign with Developer ID, notarize and zip the app for a release."
  desc "Needs VERSION (e.g. 1.2.0). Writes build/NextUp-<version>.zip. Used by CI."
  lane :release do
    setup_ci if ENV["CI"]

    api_key = asc_api_key
    team = nextup_team_id
    version = release_version
    build_number = ENV.fetch("GITHUB_RUN_NUMBER", "1")

    match(readonly: true, api_key: api_key, team_id: team)

    # The project signs automatically with an Apple Development certificate
    # for local runs. A release signs manually with Developer ID instead.
    build_app(
      project: project_path,
      scheme: "NextUp",
      configuration: "Release",
      export_method: "developer-id",
      output_directory: build_dir,
      output_name: "NextUp",
      clean: true,
      skip_package_pkg: true,
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{team}",
        "CODE_SIGN_IDENTITY='Developer ID Application'",
        "MARKETING_VERSION=#{version}",
        "CURRENT_PROJECT_VERSION=#{build_number}"
      ].join(" "),
      export_options: {
        method: "developer-id",
        signingStyle: "manual",
        teamID: team,
        signingCertificate: "Developer ID Application"
      }
    )

    app = File.join(build_dir, "NextUp.app")
    UI.user_error!("Expected #{app} after export") unless File.directory?(app)

    # Notarizes and staples the ticket, so Gatekeeper accepts the app offline.
    notarize(package: app, api_key: api_key)
    sh("spctl", "--assess", "--verbose=2", "--type", "execute", app)

    zip = File.join(build_dir, "NextUp-#{version}.zip")
    # ditto, not zip: it keeps the extended attributes the signature needs.
    sh("ditto", "-c", "-k", "--keepParent", app, zip)
    UI.success("Notarized release: #{zip}")
  end
end
